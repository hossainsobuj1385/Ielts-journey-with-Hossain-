# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_WEBAPP_URL=https://your-botkeep-app.botkeep.cloud

# MySQL / MariaDB Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ielts_journey
DB_USER=root
DB_PASSWORD=your_db_password
DB_CA=

# Admin Authorization (Comma-separated Telegram User IDs who can access Admin Panel)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Server Configuration (Botkeep.cloud / Production)
NODE_ENV=production
PORT=3000

# Optional AI / Hosting vars
GEMINI_API_KEY=
APP_URL=
